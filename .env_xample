APP_NAME="Demo" # đổi thành tên website, ví dụ: ABC
APP_ENV=local # đổi thành production nếu là production
APP_KEY=base64:lkBsXC86PiVSkgCGjFn32wSHS1d3HbgJLQmSI7px7qI=
APP_DEBUG=true
APP_URL=http://localhost:8000 # đổi thành tên domain, ví dụ: https://abc.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1 # đổi thành tên host database, ví dụ: 127.0.0.1
DB_PORT=3306 # đổi thành tên port database, ví dụ: 3306
DB_DATABASE=campaff # đổi thành tên database, ví dụ: abc
DB_USERNAME=root # đổi thành tên username database, ví dụ: root
DB_PASSWORD= # đổi thành tên password database, ví dụ: 12345678

BROADCAST_DRIVER=log1
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME= ABC@gmail.com #nhập email gmail của bạn, ví dụ: ABC@gmail.com
MAIL_PASSWORD= fsdf342312 #nhập password gmail của bạn, cách lấy: https://wiki.nhanhoa.com/kb/huong-dan-lay-mat-khau-ung-dung-mail-tren-tai-khoan-gmail/
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS= ABC@gmail.com #nhập email gmail của bạn
MAIL_FROM_NAME="Demo" # đổi thành tên website, ví dụ: "ABC"

# Nhận mail (IMAP) — dùng chung MAIL_USERNAME / MAIL_PASSWORD (App Password Gmail)
# IMAP_SYNC_LIMIT=100          # Lần đầu: tải tối đa 100 email mới nhất. Sau đó: chỉ email mới (tối đa 100/lần)
# IMAP_AUTO_SYNC_SECONDS=120   # Tự đồng bộ nền mỗi 120s (cần cron: php artisan schedule:run)
# IMAP_INCREMENTAL_SYNC=true   # Chỉ tải email chưa có trong DB (khuyên bật)
# IMAP_UI_POLL_SECONDS=15           # Tự cập nhật bảng Nhận mail (giây)
# IMAP_NOTIFICATIONS_POLL_SECONDS=10 # Chuông thông báo admin kiểm tra mỗi N giây

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_ANALYTICS_ID=
INSTAGRAM_URL= https://www.instagram.com/abc #nhập URL Instagram của bạn, ví dụ: https://www.instagram.com/abc

